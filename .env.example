# Copy to .env and adjust. Docker Compose reads .env automatically.
# Everything here has a development-grade default in docker-compose.yml;
# POSTGRES_PASSWORD must be set to a real secret for any shared environment.

APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# Published port of the gRPC API on the host.
GRPC_PORT=50051

POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=app
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# Image version stamped into the binary and logged at startup.
VERSION=dev
